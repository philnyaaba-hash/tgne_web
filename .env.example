# LandLedger notification relay — copy to .env and fill in real values.
# Never commit .env or paste these values into the app, a backup or chat.

# PostgreSQL. Use a local Postgres URL for development and your Neon connection
# string in Vercel Environment Variables. Never commit either connection string.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/landledger?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-random-secret-at-least-32-bytes

# One-time initial administrator bootstrap (do not use the demo login password).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
BOOTSTRAP_ADMIN_NAME=Workspace Administrator

# Optional application-level encryption key for visitor ID numbers.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VISITOR_DATA_KEY=

# Where the relay listens. Keep 127.0.0.1 unless you put a reverse proxy in front.
HOST=127.0.0.1
PORT=8787

# Shared secret the app sends as x-workspace-key. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKSPACE_KEY=change-me-to-a-long-random-string

# Use EITHER an incoming webhook (simplest; Slack chooses its channel) ...
SLACK_WEBHOOK_URL=

# ... OR a Slack bot token with chat:write and the target channel ID.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL=C0123456789

# Slack API host used only with SLACK_BOT_TOKEN; leave this default for Slack.
# Only change this to point at a mock while testing.
SLACK_API_BASE=https://slack.com/api

# Optional private workspace invite link (https://join.slack.com/...). Shown to
# administrators while onboarding staff and emailed by the "Send Slack invite"
# action. Leave blank to disable invitations; there is deliberately no default.
SLACK_INVITE_URL=

# ---- Email alerts (SMTP) ----
# Works with any mailbox: Gmail app password, Zoho, Outlook, your host, etc.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587/25 (STARTTLS is used if offered)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=alerts@yourdomain.com
# Leave empty to use the business email saved in Settings.
EMAIL_TO=

# ---- Email notifications (Resend) ----
# Server-only. Create a key at https://resend.com/api-keys and paste the full
# value here; never commit it or paste it into chat. The masked key shown in
# the Resend dashboard is a redaction, not a usable credential.
RESEND_API_KEY=
# EMAIL_FROM (above) must be a verified sender/domain in Resend, e.g.
# "LandLedger <alerts@yourdomain.com>".
# Optional Reply-To header for visitor and host notifications.
EMAIL_REPLY_TO=
# Public base URL used for links in emails. Set this in production.
APP_URL=http://localhost:3000

# ---- WhatsApp alerts (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio's WhatsApp sandbox sender is a quick way to test:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=+233000000000
# Optional approved template (HX...) with one variable {{1}}.
# Needed for business-initiated messages outside a 24-hour WhatsApp session.
TWILIO_CONTENT_SID=
# Only change this to point at a mock while testing.
TWILIO_API_BASE=https://api.twilio.com

# ---- Demo quick sign-in ----
# Set to 1 to show one-click demo role buttons on the dashboard sign-in screen.
# Uses dedicated demo.*@landledger.test accounts (npm run seed:demo), never real
# users. Forced off on Vercel production deployments. Leave unset in production.
DEMO_QUICK_LOGIN=0
