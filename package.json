{
  "name": "landledger",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.js",
    "test:a11y:strict": "cross-env A11Y_STRICT=1 playwright test tests/e2e/accessibility.spec.js",
    "test:public": "playwright test tests/e2e/public-pages.spec.js",
    "check:links": "playwright test tests/e2e/links.spec.js",
    "check:assets": "node scripts/check-assets.mjs",
    "check": "npm test && npm run check:assets",
    "verify": "npm run check && npm run test:e2e && npm run build",
    "icons": "node scripts/generate-icons.mjs",
    "assets:optimize": "node scripts/optimize-land-images.mjs",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "check:env": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-env.mjs",
    "smoke": "node scripts/smoke.mjs",
    "relay": "node relay/slack-relay.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.cjs",
    "db:seed-land": "node scripts/seed-land.cjs",
    "seed:demo": "node scripts/seed-demo-accounts.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "next": "^15.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.37.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "cross-env": "^10.1.0",
    "lighthouse": "^13.6.0",
    "prisma": "^6.19.3"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
